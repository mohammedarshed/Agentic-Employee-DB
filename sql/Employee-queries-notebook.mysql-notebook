    "content": "\\about\nSELECT * FROM employees;\nSELECT first_name, last_name, annual_salary\nFROM employees\nWHERE annual_salary > 1200000;\nSELECT\n    d.department_name,\n    AVG(e.annual_salary) AS average_salary\nFROM employees e\nJOIN departments d\n    ON e.department_id = d.department_id\nGROUP BY d.department_name;\nSELECT\n    e.first_name,\n    e.last_name,\n    p.project_name\nFROM employees e\nJOIN employee_projects ep\n    ON e.employee_id = ep.employee_id\nJOIN projects p\n    ON ep.project_id = p.project_id;\nUSE employee_db;\n\nSELECT COUNT(*) FROM employees;\nSELECT COUNT(*) FROM departments;\nSELECT COUNT(*) FROM projects;\nSELECT * FROM `employee_db`.`employees`\nselect * from conversations\nselect * from conversation_messages cm join conversations c on c.session_id = cm.session_id where c.session_id in ('11283766-63b3-4459-9958-26ecf4e06ebb')\n",
